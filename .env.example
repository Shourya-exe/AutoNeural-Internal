# Separate from the archived Business OS configuration.
# On a public deployment, set your exact HTTPS origin.
CRM_APP_URL=http://localhost:3100
CRM_DATABASE_PATH=data/autoneural-crm.sqlite

# Email Notifications (Resend - Recommended)
# Obtain your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="AutoNeural Workspace <notifications@autoneural.in>"

# Optional: EmailJS fallback configuration (https://www.emailjs.com)
# EMAILJS_SERVICE_ID=service_xxx
# EMAILJS_TEMPLATE_ID=template_xxx
# EMAILJS_PUBLIC_KEY=user_xxx
# EMAILJS_PRIVATE_KEY=access_token_xxx
