# ==============================================================================
# AutoNeural workspace — environment variables
# Copy to .env.local for development, or .env.production on the server.
# Never commit filled-in copies. Every integration below is optional; the
# workspace shows an honest "not connected" state for anything left blank.
# ==============================================================================

# ── Core ──────────────────────────────────────────────────────────────────────
# Exact public origin. HTTPS in production (makes session cookies Secure and is
# used in links inside emails).
CRM_APP_URL=http://localhost:3000
# SQLite database. Use an absolute path on a persistent disk in production.
CRM_DATABASE_PATH=data/autoneural-crm.sqlite
# Uploaded task files. Defaults to an "uploads" folder next to the database.
CRM_UPLOAD_DIR=
# Largest task attachment in MB (default 25).
CRM_MAX_UPLOAD_MB=25
# Signs public links (unsubscribe). Optional: if blank, a random secret is
# generated once and stored in the database. Generate: openssl rand -base64 32
CRM_SECRET=
# Extra exact origins allowed to make state-changing requests (comma separated).
# Leave blank unless the app is served from more than one hostname.
CRM_ALLOWED_ORIGINS=

# ── First start ───────────────────────────────────────────────────────────────
# On an EMPTY database, creates the master admin (info@autoneural.in) with this
# temporary password (12+ characters). They must change it at first sign-in.
# Remove it after the first login. Alternatively run `npm run setup`.
CRM_ADMIN_BOOTSTRAP_PASSWORD=
# Master admin recovery (nobody can approve the master admin's reset in the app):
# set a temporary password (12+ characters) and restart. It must be changed at
# sign-in, and each value is applied only once. Remove it afterwards.
CRM_MASTER_ADMIN_RESET_PASSWORD=

# ── Email (pick one; SMTP wins if several are set) ────────────────────────────
# Without a provider, production sends nothing and says so; development logs
# emails to the console instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="AutoNeural Workspace <info@autoneural.in>"
RESEND_API_KEY=
RESEND_FROM_EMAIL="AutoNeural Workspace <notifications@autoneural.in>"
# "true" when your Resend domain lets users send as themselves.
RESEND_DOMAIN_VERIFIED=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Inbound email webhook (POST /api/mail/inbound). Disabled until set.
# Send it as "Authorization: Bearer <secret>" or ?key=<secret>.
MAIL_INBOUND_SECRET=

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
AI_MODEL=

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Webhook: Meta app → WhatsApp → Configuration → <CRM_APP_URL>/api/whatsapp/webhook,
# verify token = WHATSAPP_VERIFY_TOKEN, subscribe to "messages".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app → App settings → Basic → App secret. Webhooks are rejected without it.
WHATSAPP_APP_SECRET=
# Any random string you choose; enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved utility template the AI call agent uses outside the 24-hour window;
# its body variable {{1}} receives the message. Format: name or name:language
WHATSAPP_FOLLOWUP_TEMPLATE=

# ── Facebook & Instagram Lead Ads (Meta) ──────────────────────────────────────
# Webhook: Meta app → Webhooks → Page → <CRM_APP_URL>/api/facebook/webhook, field
# "leadgen"; then Leads → Automatic lead sources → Subscribe Page.
# Page access token with leads_retrieval, pages_manage_metadata, pages_show_list,
# pages_read_engagement and pages_manage_ads.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Only if Lead Ads use a different Meta app / verify token than WhatsApp.
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=

# ── AI calling agent (voice-agent/, LiveKit) ─────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
OUTBOUND_TRUNK_ID=
VOBIZ_SIP_TRUNK_ID=
AGENT_NAME=autoneural-crm-assistant
AGENT_HEALTH_PORT=8082
# "true" when the agent runs as its own service rather than started from the app.
AGENT_EXTERNAL=
# Python that runs voice-agent/agent.py. Default: voice-agent/.venv, then the system Python.
AGENT_PYTHON=
# Shared secret the agent uses to post calls back (24+ characters).
AGENT_INGEST_SECRET=
# Where the agent posts results; defaults to CRM_APP_URL.
CRM_URL=

# ── Click-to-call (Exotel) ────────────────────────────────────────────────────
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Meetings (Zoom; Jitsi links need no setup) ────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Build / optional ──────────────────────────────────────────────────────────
# Set at BUILD time to proxy /api/v1/* to the separate NestJS API (backend/).
NEST_BACKEND_URL=
