# ==============================================================================
# AutoNeural Production Environment Configuration
# Subdomain: crm.autoneural.in (or your chosen subdomain)
# ==============================================================================

# Public URL of the application
CRM_APP_URL=https://crm.autoneural.in

# SQLite Database storage path (inside container or Hostinger user root)
CRM_DATABASE_PATH=data/autoneural-crm.sqlite

# Domain for Caddy / Reverse proxy SSL
APP_DOMAIN=crm.autoneural.in

# Node Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ==============================================================================
# Automated Email Notifications (Resend / EmailJS)
# ==============================================================================
# Resend API key (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Production sender address (or onboarding@resend.dev during testing)
RESEND_FROM_EMAIL="AutoNeural Workspace <notifications@autoneural.in>"

# Optional EmailJS configuration
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
