# ==============================================================================
# AutoNeural workspace — production environment (e.g. https://work.autoneural.in)
# Copy to .env.production on the server (chmod 600). Never commit the copy.
# See .env.example for every optional integration.
# ==============================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Exact public HTTPS origin.
CRM_APP_URL=https://work.autoneural.in
# Absolute paths on persistent storage, OUTSIDE the web document root.
CRM_DATABASE_PATH=/home/USER/autoneural-work/data/autoneural-crm.sqlite
CRM_UPLOAD_DIR=/home/USER/autoneural-work/data/uploads
CRM_MAX_UPLOAD_MB=25

# Domain for Caddy / reverse proxy SSL (Docker deployments).
APP_DOMAIN=work.autoneural.in

# First start on an empty database only; remove after the master admin signs in.
CRM_ADMIN_BOOTSTRAP_PASSWORD=

# Email delivery (required for notifications to leave the workspace).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@autoneural.in
SMTP_PASS=
SMTP_FROM_EMAIL="AutoNeural Workspace <info@autoneural.in>"

# Inbound email webhook secret (openssl rand -base64 32); blank disables the endpoint.
MAIL_INBOUND_SECRET=
