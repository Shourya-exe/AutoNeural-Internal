{
  "name": "autoneural-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"NEXT,NEST\" -c \"cyan.bold,magenta.bold\" \"next dev --port 3000\" \"npm --prefix backend run start:dev\"",
    "dev:frontend": "next dev --port 3000",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "next build && npm --prefix backend run build",
    "start": "concurrently -k -p \"[{name}]\" -n \"NEXT,NEST\" -c \"cyan.bold,magenta.bold\" \"next start --port 3000\" \"npm --prefix backend run start:prod\"",
    "start:frontend": "next start --port 3000",
    "start:backend": "npm --prefix backend run start:prod",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "test:e2e": "node --import tsx scripts/e2e.ts",
    "backend:dev": "npm --prefix backend run start:dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start:prod",
    "backend:seed": "npm --prefix backend run prisma:seed",
    "backend:test": "npm --prefix backend run test",
    "package:zip": "node scripts/package-hostinger-zip.js work",
    "package:work": "node scripts/package-hostinger-zip.js work",
    "package:crm": "node scripts/package-hostinger-zip.js crm"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.0",
    "@fontsource/noto-sans-bengali": "^5.2.0",
    "@fontsource/noto-sans-devanagari": "^5.2.0",
    "@next/env": "^16.3.4",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.28.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
