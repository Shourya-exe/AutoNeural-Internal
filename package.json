{
  "name": "autoneural-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "test:e2e": "node --import tsx scripts/e2e.ts",
    "backend:dev": "npm --prefix backend run start:dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start:prod",
    "backend:seed": "npm --prefix backend run prisma:seed",
    "package:zip": "node scripts/package-hostinger-zip.js work",
    "package:work": "node scripts/package-hostinger-zip.js work",
    "package:crm": "node scripts/package-hostinger-zip.js crm"
  },
  "dependencies": {
    "next": "^16.3.4",
    "@next/env": "^16.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2",
    "pdfkit": "^0.17.2",
    "@fontsource/noto-sans": "^5.2.0",
    "@fontsource/noto-sans-devanagari": "^5.2.0",
    "@fontsource/noto-sans-bengali": "^5.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.3",
    "prettier": "^3.5.3",
    "@types/pdfkit": "^0.17.3",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
