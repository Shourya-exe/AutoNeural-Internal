generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum AttachmentType {
  FILE
  DOCUMENT
  LINK
}

enum AttachmentPurpose {
  REFERENCE
  OUTPUT
  FOR_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityAction {
  CREATED
  ASSIGNED
  REASSIGNED
  UPDATED
  STATUS_CHANGED
  PROGRESS_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  SUBMISSION_FOR_APPROVAL
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
}

enum RemovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_UPDATED
  STATUS_CHANGED
  PROGRESS_UPDATED
  TASK_COMPLETED
  DUE_DATE_APPROACHING
  REMOVAL_REQUESTED
  REMOVAL_APPROVED
  REMOVAL_REJECTED
  ATTACHMENT_ADDED
  SUBMISSION_FOR_APPROVAL
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  tasks           Task[]
  removalRequests EmployeeRemovalRequest[]
  accounts        Account[]
  contacts        Contact[]
  dealStages      DealStage[]
  deals           Deal[]
  crmActivities   CrmActivity[]

  @@map("organizations")
}

model User {
  id                 String        @id @default(uuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email              String
  passwordHash       String
  name               String
  role               Role          @default(EMPLOYEE)
  status             AccountStatus @default(ACTIVE)
  department         String?
  jobTitle           String?
  avatarUrl          String?
  mustChangePassword Boolean       @default(false)
  /// Global (platform) master admin: passes every role check and cannot be demoted, deactivated or removed.
  /// Only ever set by migration/seed, never from user input or by email match.
  isPlatformAdmin    Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  createdTasks            Task[]                   @relation("TaskCreator")
  assignments             TaskAssignment[]
  activities              TaskActivity[]
  comments                Comment[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  targetedRemovalRequests EmployeeRemovalRequest[] @relation("TargetEmployee")
  createdRemovalRequests  EmployeeRemovalRequest[] @relation("RemovalRequester")
  reviewedRemovalRequests EmployeeRemovalRequest[] @relation("RemovalReviewer")
  taskAttachments         TaskAttachment[]
  ownedAccounts           Account[]                @relation("AccountOwner")
  ownedContacts           Contact[]                @relation("ContactOwner")
  ownedDeals              Deal[]                   @relation("DealOwner")
  ownedCrmActivities      CrmActivity[]            @relation("CrmActivityOwner")
  createdCrmActivities    CrmActivity[]            @relation("CrmActivityCreator")

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Task {
  id             String       @id @default(uuid())
  number         Int          @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title          String
  description    String       @default("")
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  progress       Int          @default(0)
  project        String?
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments TaskAssignment[]
  activities  TaskActivity[]
  comments    Comment[]
  attachments TaskAttachment[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, dueDate])
  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, employeeId])
  @@index([employeeId])
  @@index([taskId])
  @@map("task_assignments")
}

model TaskActivity {
  id            String         @id @default(uuid())
  taskId        String
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        ActivityAction
  previousValue String?
  newValue      String?
  comment       String?
  createdAt     DateTime       @default(now())

  @@index([taskId, createdAt])
  @@index([userId])
  @@map("task_activities")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model EmployeeRemovalRequest {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User                 @relation("TargetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User                 @relation("RemovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById   String?
  reviewedBy     User?                @relation("RemovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  status         RemovalRequestStatus @default(PENDING)
  reason         String?
  reviewNote     String?
  createdAt      DateTime             @default(now())
  reviewedAt     DateTime?

  @@index([organizationId, status])
  @@index([employeeId])
  @@map("employee_removal_requests")
}

model TaskAttachment {
  id             String            @id @default(uuid())
  taskId         String
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId     String
  uploader       User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  name           String
  type           AttachmentType
  url            String
  storagePath    String?
  fileSize       Int?
  mimeType       String?
  purpose        AttachmentPurpose @default(OUTPUT)
  approvalStatus ApprovalStatus?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([taskId])
  @@index([uploaderId])
  @@map("task_attachments")
}


// ─── CRM (Business OS phase 1: sales execution) ─────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CUSTOMER
}

enum LeadSource {
  MANUAL
  WEBSITE
  FACEBOOK
  WHATSAPP
  CALL
  REFERRAL
  IMPORT
  OTHER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum CrmActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  FOLLOW_UP
  SYSTEM
}

model Account {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?        @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  gstin          String?
  industry       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts Contact[]
  deals    Deal[]

  @@index([organizationId, name])
  @@map("accounts")
}

// A contact is a lead until it becomes a CUSTOMER; lead status is separate from deal stage.
model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  phone          String?
  email          String?
  source         LeadSource   @default(MANUAL)
  leadStatus     LeadStatus   @default(NEW)
  lostReason     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deals      Deal[]
  activities CrmActivity[]

  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, ownerId, leadStatus])
  @@map("contacts")
}

model DealStage {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int
  probability    Int          @default(0)

  deals Deal[]

  @@unique([organizationId, name])
  @@index([organizationId, position])
  @@map("deal_stages")
}

model Deal {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId         String
  contact           Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId         String?
  account           Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  stageId           String
  stage             DealStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  ownerId           String?
  owner             User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  title             String
  value             Decimal      @default(0) @db.Decimal(14, 2)
  status            DealStatus   @default(OPEN)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activities CrmActivity[]

  @@index([organizationId, status, stageId])
  @@index([organizationId, ownerId])
  @@index([contactId])
  @@map("deals")
}

// One table for the customer timeline: logged calls/messages/meetings/notes,
// follow-ups (dueAt set, completedAt null = pending) and SYSTEM change events.
model CrmActivity {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?           @relation("CrmActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User            @relation("CrmActivityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  type           CrmActivityType
  subject        String
  notes          String?
  outcome        String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([contactId, createdAt])
  @@index([organizationId, ownerId, completedAt, dueAt])
  @@map("crm_activities")
}
