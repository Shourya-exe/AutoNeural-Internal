PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000,http://localhost:3100

# PostgreSQL Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/autoneural_crm?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="your-jwt-access-secret-minimum-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-minimum-32-chars-long"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# Email Notifications (Resend / EmailJS)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="AutoNeural Workspace <notifications@autoneural.in>"
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
