PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
# Browser origins allowed by CORS (comma separated, exact). The first one is also used
# for links in emails, e.g. the password reset page.
FRONTEND_URL=http://localhost:3000,http://localhost:3100

# PostgreSQL Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/autoneural_crm?schema=public"

# Authentication secrets — REQUIRED, 32+ random characters each, different from each other.
# Generate with: openssl rand -base64 48
# The server refuses to start without them (and with these example values in production).
JWT_ACCESS_SECRET="your-jwt-access-secret-minimum-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-minimum-32-chars-long"
JWT_REFRESH_EXPIRES_IN="7d"

# Public POST /auth/register creates a new organization + admin. Off unless "true".
ALLOW_PUBLIC_REGISTRATION=false
# Swagger UI at /api/docs: always in development; in production only when "true".
ENABLE_SWAGGER=false
# Page that receives ?token=… from password reset emails (default: first FRONTEND_URL + /reset-password).
PASSWORD_RESET_URL=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# Email (SMTP preferred; Resend or EmailJS as alternatives)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL="AutoNeural Workspace <notifications@autoneural.in>"
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
