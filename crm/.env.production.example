# ═════════════════════════════════════════════════════════════════════════════
# AutoNeural CRM — Production Environment Template
# Deployment Target: Hostinger Cloud + Supabase -> https://crm.autoneural.in
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Application & Base URLs ───────────────────────────
APP_URL=https://crm.autoneural.in
NEXTAUTH_URL=https://crm.autoneural.in
AUTH_URL=https://crm.autoneural.in/api/auth
LOGIN_URL=https://crm.autoneural.in/login
ENQUIRY_URL=https://crm.autoneural.in/enquiry

DISPLAY_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEMO_MODE="false"

# ─────────────────────────── Supabase PostgreSQL Database ───────────────────────────
# Runtime: TRANSACTION POOLER (Port 6543, PgBouncer flags enabled)
DATABASE_URL=postgresql://postgres.${PROJECT_REF}:${DB_PASSWORD}@aws-0-${REGION}.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Migrations & Direct Session: SESSION POOLER (Port 5432, IPv4 compatible)
# Note: Using pooler port 5432 is recommended over db.${PROJECT_REF}.supabase.co:5432 because it works on IPv4 networks
DIRECT_URL=postgresql://postgres.${PROJECT_REF}:${DB_PASSWORD}@aws-0-${REGION}.pooler.supabase.com:5432/postgres

# ─────────────────────────── Supabase REST & Auth APIs ───────────────────────────
SUPABASE_PROJECT_REF=${PROJECT_REF}
SUPABASE_REGION=${REGION}
NEXT_PUBLIC_SUPABASE_URL=https://${PROJECT_REF}.supabase.co
SUPABASE_REST_URL=https://${PROJECT_REF}.supabase.co/rest/v1
SUPABASE_AUTH_URL=https://${PROJECT_REF}.supabase.co/auth/v1
SUPABASE_STORAGE_URL=https://${PROJECT_REF}.supabase.co/storage/v1
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}

# ─────────────────────────── Authentication & Security ───────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=${GENERATE_WITH_NPX_AUTH_SECRET}
AUTH_TRUST_HOST=true

# Site-wide HTTP Basic Auth password wall (protects subdomain from open internet)
BASIC_AUTH_USER=autoneural
BASIC_AUTH_PASSWORD=${A_LONG_SHARED_PASSWORD}
BASIC_AUTH_REALM=AutoNeural CRM

# Generate with: openssl rand -base64 32
# BACK THIS UP! Required to decrypt stored channel tokens.
INTEGRATION_ENCRYPTION_KEY=${GENERATE_WITH_OPENSSL_RAND_BASE64_32}

# ─────────────────────────── Background Scheduling & Sweeps ───────────────────────────
# Hostinger Cloud does not provide Redis. Leave REDIS_URL empty for inline processing.
REDIS_URL=

# Generate with: openssl rand -hex 32
# hPanel -> Advanced -> Cron Jobs, run every 1-5 minutes:
# curl -fsS -m 50 -H "x-cron-secret: ${CRON_SECRET}" https://crm.autoneural.in/api/cron/sweep >/dev/null
CRON_SECRET=${GENERATE_WITH_OPENSSL_RAND_HEX_32}
CRON_SWEEP_URL=https://crm.autoneural.in/api/cron/sweep
HEALTH_CHECK_URL=https://crm.autoneural.in/api/health

# ─────────────────────────── Webhook Endpoints & API URLs ───────────────────────────
# Public website form submission endpoint (POST from autoneural.in)
WEBSITE_FORM_ENDPOINT_URL=https://crm.autoneural.in/api/public/enquiry
WEBSITE_FORM_SIGNING_SECRET=
WEBSITE_FORM_RATE_PER_MINUTE=5

# WhatsApp Business API webhook callback URL
WHATSAPP_CALLBACK_URL=https://crm.autoneural.in/api/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Meta (Facebook/Instagram) Lead Ads webhook callback URL
META_LEADADS_CALLBACK_URL=https://crm.autoneural.in/api/webhooks/meta-lead-ads
META_LEADADS_APP_SECRET=
META_LEADADS_VERIFY_TOKEN=
META_LEADADS_PAGE_ACCESS_TOKEN=

# Facebook Messenger webhook callback URL
MESSENGER_CALLBACK_URL=https://crm.autoneural.in/api/webhooks/messenger
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# Instagram Messaging webhook callback URL
INSTAGRAM_CALLBACK_URL=https://crm.autoneural.in/api/webhooks/instagram
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ─────────────────────────── Optional AI Configuration ───────────────────────────
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ─────────────────── AI voice agent (agent.py) ───────────────────
# LiveKit Cloud project the Python worker registers with (https://cloud.livekit.io/).
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
DEEPGRAM_API_KEY=""
# google | groq | openai — the others (if keyed) are used as fallbacks.
LLM_PROVIDER="google"
GOOGLE_API_KEY=""
GOOGLE_API_KEY_2=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
# Sarvam powers Hindi/Bengali speech. TTS_PROVIDER: deepgram | sarvam
SARVAM_API_KEY=""
SARVAM_VOICE="anushka"
TTS_PROVIDER="deepgram"
DEEPGRAM_TTS_MODEL="aura-2-thalia-en"
# Vobiz SIP trunk (LiveKit outbound trunk id) and numbers.
OUTBOUND_TRUNK_ID=""
VOBIZ_SIP_DOMAIN=""
VOBIZ_OUTBOUND_NUMBER=""
DEFAULT_TRANSFER_NUMBER=""
# Worker health-check port (the CRM's Start/Stop agent button probes it).
AGENT_HEALTH_PORT="8082"
# LiveKit agent name the CRM dispatches to; must be unique on the LiveKit project.
AGENT_NAME="autoneural-crm-assistant"
# Shared secret the worker uses to post finished calls to /api/agent/calls.
# Generate with: openssl rand -hex 32
AGENT_INGEST_SECRET=""
# Organization that inbound calls are filed under (optional when there is only one).
AGENT_DEFAULT_ORG_ID=""
# Call logging to Google Sheets (rows go to the "calls" tab).
GOOGLE_SERVICE_ACCOUNT_JSON="./service-account.json"
GOOGLE_SHEET_ID=""

# Require sign-in (the /login page). Set to "false" only for an open demo preview
# (with DEMO_MODE=true, visitors are then auto-signed-in as the demo Admin).
AUTH_REQUIRED="true"

# ─────────────────── WhatsApp via Twilio ───────────────────
# With TWILIO_ACCOUNT_SID set, WhatsApp uses Twilio (set WHATSAPP_PROVIDER="meta" to use the
# Meta Cloud API instead). Webhook for "A message comes in": APP_URL/api/webhooks/whatsapp
WHATSAPP_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sandbox: whatsapp:+14155238886 — or your approved WhatsApp sender number.
TWILIO_WHATSAPP_FROM=""
# Optional: Messaging Service SID (used instead of TWILIO_WHATSAPP_FROM when set).
TWILIO_MESSAGING_SERVICE_SID=""
# Optional: exact webhook URL configured in Twilio, if it differs from APP_URL/api/webhooks/whatsapp.
TWILIO_WEBHOOK_URL=""
# Optional: approved Content Template (HX...) the voice agent uses to send listings outside 24h.
# Variables: {{1}} name, {{2}} property title, {{3}} locality | price
TWILIO_WHATSAPP_CONTENT_SID=""

COMPANY_PHONE="+916297927642"

WHATSAPP_DISPLAY_NUMBER="+916297927642"

# Voice-call WhatsApp follow-up: approved BODY template with {{1}}=name, {{2}}=summary.
# Required when the customer has not sent a WhatsApp message in the last 24 hours.
VOICE_WHATSAPP_TEMPLATE_NAME=""
VOICE_WHATSAPP_TEMPLATE_LANGUAGE="en"
# For Twilio use its approved Content SID instead of the Meta template name.
VOICE_WHATSAPP_CONTENT_SID=""
