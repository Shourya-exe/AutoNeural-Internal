# ═════════════════════════════════════════════════════════════════════════════
# AutoNeural CRM — environment configuration
#
#   Local development :  cp .env.example .env   and fill in the Core section.
#   Production        :  see .env.production.example — a paste-ready template
#                        for Hostinger Cloud + Supabase.
#
# Never commit .env. Generate every secret fresh; do not ship these examples.
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Core ───────────────────────────

# Runtime database connection.
#   Local   : embedded PostgreSQL from `npm run db:local` (port 55432),
#             or docker compose (port 5432)
#   Supabase: the TRANSACTION POOLER, port 6543 —
#             postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://autoneural:autoneural@localhost:55432/autoneural_crm?schema=public"

# Direct (session) connection, used ONLY for migrations. Must ALWAYS be set —
# Prisma errors if the variable is missing.
#   Local   : the same value as DATABASE_URL
#   Supabase: the DIRECT connection, port 5432 —
#             postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# A transaction pooler cannot hold prepared statements or advisory locks, which
# is why migrations need this separate endpoint.
DIRECT_URL="postgresql://autoneural:autoneural@localhost:55432/autoneural_crm?schema=public"

# Public base URL. Shown as the webhook callback URL in Settings → Integrations,
# so it must match exactly what you give Meta.
APP_URL="http://localhost:3000"

# Timestamps are always STORED in UTC. This is the display timezone only.
DISPLAY_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# ─────────────────────────── Auth ───────────────────────────

# Session signing key. Generate: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ─────────────────── Site-wide password wall ───────────────────
# Set BOTH to put the whole deployment behind a browser password prompt, in
# front of the app's own sign-in. Leave blank for local development.
#
# Deliberately BYPASSED (a prompt would break these):
#   /api/webhooks/*  Meta cannot send Basic credentials — signature-verified
#   /api/public/*    posted by site visitors — rate-limited, honeypot, HMAC
#   /api/cron/*      a cron job cannot answer a prompt — uses CRON_SECRET
#   /enquiry         the public example form
#   /api/health      uptime monitoring
#
# Only meaningful over HTTPS. Middleware reads these at startup — restart the
# app after changing them.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
BASIC_AUTH_REALM="AutoNeural CRM"

# ─────────────── Scheduler-driven background work ───────────────
# REQUIRED on any host that cannot run a second always-on process
# (Hostinger Cloud, most managed Node hosting).
#
# Set a long random secret (openssl rand -hex 32), then schedule every minute:
#   curl -fsS -m 50 -H "x-cron-secret: YOUR_SECRET" \
#        https://crm.autoneural.in/api/cron/sweep >/dev/null
#
# Does the same work as `npm run worker:start`: drains stranded webhook events,
# retries failed ones, sends no-response reminders, escalates overdue follow-ups.
# Every action is idempotent, so a frequent schedule cannot cause duplicates.
# Leave blank on a VPS where the worker runs — the endpoint then returns 503.
CRON_SECRET=""

# ─────────────────────────── Demo mode ───────────────────────────
# "true"  : synthetic seed data, a DEMO banner, unauthenticated visitors resolve
#           to the demo Admin, and ALL real outbound provider calls are blocked.
# "false" : real production behaviour. Required for live use.
DEMO_MODE="false"

# ─────────────────── Redis / BullMQ (optional) ───────────────────
# With a value: webhook routes enqueue work and `npm run worker:start` consumes
# it — ingestion survives restarts and never blocks the provider's request.
# Blank: events process INLINE in the request, and the cron sweep above recovers
# anything stranded. This is the Hostinger Cloud setup, since Cloud plans do not
# offer Redis.
REDIS_URL="redis://localhost:6379"

# ───────────── Encryption for integration tokens at rest ─────────────
# 32-byte key, base64. Generate: openssl rand -base64 32
# BACK THIS UP. Without it, stored provider tokens cannot be decrypted.
INTEGRATION_ENCRYPTION_KEY="replace-me-32-byte-base64-key===="

# ─────────────────── Optional AI assistance ───────────────────
# The CRM is fully usable without this — the panel renders a clear disabled
# state. Leave blank to keep it off. Supported: "anthropic" or "openai".
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ═════════════════════════════════════════════════════════════════════════════
# Provider credentials — REQUIRED ONLY FOR LIVE CHANNEL ACCESS.
#
# Every adapter is implemented. Without these, Settings → Integrations →
# "Send test event" exercises the full ingestion pipeline with clearly labelled
# simulated events. Nothing is "connected" until these are set AND the
# provider-side configuration and App Review are complete.
#
# External steps per channel: docs/INTEGRATIONS.md
# ═════════════════════════════════════════════════════════════════════════════

# ---- A. WhatsApp Business Platform (Meta Cloud API) ----
WHATSAPP_APP_SECRET=""             # verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=""           # webhook GET hub.verify_token challenge
WHATSAPP_ACCESS_TOKEN=""           # system-user / long-lived token, for sending
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""

# ---- B. Meta Lead Ads (ingestion only — separate from messaging) ----
META_LEADADS_APP_SECRET=""
META_LEADADS_VERIFY_TOKEN=""
META_LEADADS_PAGE_ACCESS_TOKEN=""  # retrieves full lead detail by leadgen_id

# ---- C. Facebook Messenger ----
MESSENGER_APP_SECRET=""
MESSENGER_VERIFY_TOKEN=""
MESSENGER_PAGE_ACCESS_TOKEN=""
MESSENGER_PAGE_ID=""

# ---- D. Instagram messaging ----
INSTAGRAM_APP_SECRET=""
INSTAGRAM_VERIFY_TOKEN=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""

# ---- E. Website forms (works today, no provider approval needed) ----
# Shared secret your site uses to sign the raw JSON body (HMAC-SHA256), sent as
# `x-form-signature`. Optional — the endpoint is rate-limited and
# honeypot-protected regardless. Compute the signature SERVER-SIDE on
# autoneural.in; never put it in browser code.
WEBSITE_FORM_SIGNING_SECRET=""
WEBSITE_FORM_RATE_PER_MINUTE="5"

# ─────────────────── AI voice agent (agent.py) ───────────────────
# LiveKit Cloud project the Python worker registers with (https://cloud.livekit.io/).
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
DEEPGRAM_API_KEY=""
# google | groq | openai — the others (if keyed) are used as fallbacks.
LLM_PROVIDER="google"
GOOGLE_API_KEY=""
GOOGLE_API_KEY_2=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
# Sarvam powers Hindi/Bengali speech. TTS_PROVIDER: deepgram | sarvam
SARVAM_API_KEY=""
SARVAM_VOICE="anushka"
TTS_PROVIDER="deepgram"
DEEPGRAM_TTS_MODEL="aura-2-thalia-en"
# Vobiz SIP trunk (LiveKit outbound trunk id) and numbers.
OUTBOUND_TRUNK_ID=""
VOBIZ_SIP_DOMAIN=""
VOBIZ_OUTBOUND_NUMBER=""
DEFAULT_TRANSFER_NUMBER=""
# Worker health-check port (the CRM's Start/Stop agent button probes it).
AGENT_HEALTH_PORT="8082"
# LiveKit agent name the CRM dispatches to; must be unique on the LiveKit project.
AGENT_NAME="autoneural-crm-assistant"
# Shared secret the worker uses to post finished calls to /api/agent/calls.
# Generate with: openssl rand -hex 32
AGENT_INGEST_SECRET=""
# Organization that inbound calls are filed under (optional when there is only one).
AGENT_DEFAULT_ORG_ID=""
# Call logging to Google Sheets (rows go to the "calls" tab).
GOOGLE_SERVICE_ACCOUNT_JSON="./service-account.json"
GOOGLE_SHEET_ID=""

# Require sign-in (the /login page). Set to "false" only for an open demo preview
# (with DEMO_MODE=true, visitors are then auto-signed-in as the demo Admin).
AUTH_REQUIRED="true"

# ─────────────────── WhatsApp via Twilio ───────────────────
# With TWILIO_ACCOUNT_SID set, WhatsApp uses Twilio (set WHATSAPP_PROVIDER="meta" to use the
# Meta Cloud API instead). Webhook for "A message comes in": APP_URL/api/webhooks/whatsapp
WHATSAPP_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sandbox: whatsapp:+14155238886 — or your approved WhatsApp sender number.
TWILIO_WHATSAPP_FROM=""
# Optional: Messaging Service SID (used instead of TWILIO_WHATSAPP_FROM when set).
TWILIO_MESSAGING_SERVICE_SID=""
# Optional: exact webhook URL configured in Twilio, if it differs from APP_URL/api/webhooks/whatsapp.
TWILIO_WEBHOOK_URL=""
# Optional: approved Content Template (HX...) the voice agent uses to send listings outside 24h.
# Variables: {{1}} name, {{2}} property title, {{3}} locality | price
TWILIO_WHATSAPP_CONTENT_SID=""

COMPANY_PHONE="+916297927642"

WHATSAPP_DISPLAY_NUMBER="+916297927642"

# Voice-call WhatsApp follow-up: approved BODY template with {{1}}=name, {{2}}=summary.
# Required when the customer has not sent a WhatsApp message in the last 24 hours.
VOICE_WHATSAPP_TEMPLATE_NAME=""
VOICE_WHATSAPP_TEMPLATE_LANGUAGE="en"
# For Twilio use its approved Content SID instead of the Meta template name.
VOICE_WHATSAPP_CONTENT_SID=""
