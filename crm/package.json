{
  "name": "autoneural-crm",
  "version": "1.0.0",
  "private": true,
  "description": "AutoNeural CRM — internal sales workspace for lead capture, conversations, pipeline and follow-ups.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "db:local": "node scripts/local-db.mjs",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:bootstrap": "node scripts/bootstrap-production.mjs",
    "db:admin": "node scripts/create-admin.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "bullmq": "5.34.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "googleapis": "^181.0.0",
    "ioredis": "5.4.2",
    "libphonenumber-js": "1.11.17",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "0.469.0",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.25",
    "papaparse": "5.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/papaparse": "5.3.15",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "^17.5.0-beta.15",
    "eslint": "9.17.0",
    "eslint-config-next": "^15.5.25",
    "pg": "^8.23.0",
    "postcss": "8.4.49",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true,
    "@prisma/client@6.1.0": true,
    "@prisma/engines@6.1.0": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "prisma@6.1.0": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/darwin-arm64@17.5.0-beta.15": true
  }
}
